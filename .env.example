# Ligação à base de dados PostgreSQL (obrigatório)
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/NOME_DA_BD

# Segredo para assinar as sessões (recomendado: openssl rand -base64 32)
AUTH_SECRET=

# Password da conta de comando (por omissão: REDPTR2026)
COMANDO_PASSWORD=

# Endereço público da app (usado em QR, links e notificações push)
NEXT_PUBLIC_APP_URL=https://o-teu-endereco.app

# Opcionais — chaves VAPID para push (se omitires, a app gera e guarda automaticamente)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
